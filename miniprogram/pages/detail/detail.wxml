<view class="page" wx:if="{{memo}}">
  <view class="card">
    <view class="title">{{memo.title}}</view>
    <view class="meta">
      <text class="tag {{memo.done?'done':(memo.isDue?'warn':'ok')}}">
        {{memo.done?'已完成':(memo.isDue?'已到期':memo.relative)}}
      </text>
      <text class="time">提醒：{{memo.remindLabel || '未设置'}}</text>
    </view>
    <view class="content" wx:if="{{memo.content}}">{{memo.content}}</view>
    <view class="content muted" wx:else>暂无详细内容</view>

    <view class="sub-row">
      <text>订阅消息：{{memo.subscribed ? '已授权（可服务通知）' : '未授权（仅前台弹窗）'}}</text>
    </view>
  </view>

  <view class="actions">
    <button class="btn-primary" bindtap="onEdit">编辑</button>
    <button class="btn-ghost" bindtap="onToggle">{{memo.done ? '标为未完成' : '标为完成'}}</button>
    <button class="btn-ghost" bindtap="onResubscribe" wx:if="{{!memo.done && memo.remindAt}}">重新授权订阅提醒</button>
    <button class="btn-ghost danger" bindtap="onDelete">删除</button>
  </view>
</view>
