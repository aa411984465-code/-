.card {
  background: var(--card);
  border-radius: var(--radius);
  padding: 36rpx 32rpx;
  box-shadow: var(--shadow);
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 20rpx;
  line-height: 1.35;
}

.meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.time {
  font-size: 24rpx;
  color: var(--muted);
}

.content {
  font-size: 30rpx;
  color: var(--ink-soft);
  line-height: 1.7;
  white-space: pre-wrap;
}

.content.muted {
  color: var(--muted);
}

.sub-row {
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--paper-deep);
  font-size: 22rpx;
  color: var(--muted);
}

.actions {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.btn-ghost.danger {
  color: var(--danger);
  border-color: rgba(180, 35, 24, 0.35);
}
