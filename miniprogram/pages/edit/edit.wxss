.form {
  background: var(--card);
  border-radius: var(--radius);
  padding: 8rpx 28rpx 28rpx;
  box-shadow: var(--shadow);
}

.field {
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--paper-deep);
}

.field.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.label {
  font-size: 24rpx;
  color: var(--muted);
  margin-bottom: 12rpx;
}

.field.row .label {
  margin-bottom: 0;
}

.input {
  font-size: 32rpx;
  color: var(--ink);
}

.textarea {
  width: 100%;
  min-height: 140rpx;
  font-size: 28rpx;
  color: var(--ink);
  line-height: 1.55;
}

.picker-val {
  font-size: 28rpx;
  color: var(--ink-soft);
  padding: 8rpx 0 8rpx 24rpx;
}

.hint {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 24rpx;
  padding: 20rpx;
  background: var(--paper);
  border-radius: 12rpx;
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.5;
}

.actions {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
