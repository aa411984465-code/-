.hero {
  padding: 28rpx 8rpx 36rpx;
}

.brand {
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: var(--ink);
  line-height: 1.2;
}

.hero-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.tabs {
  display: flex;
  gap: 8rpx;
  background: rgba(255, 255, 255, 0.7);
  padding: 6rpx;
  border-radius: 14rpx;
  border: 1rpx solid var(--line);
}

.tab {
  padding: 12rpx 22rpx;
  font-size: 24rpx;
  color: var(--muted);
  border-radius: 10rpx;
}

.tab.on {
  background: var(--ink);
  color: #fff;
}

.link-settings {
  font-size: 24rpx;
  color: var(--ink-soft);
  padding: 8rpx 4rpx;
}

.memo-item {
  display: flex;
  align-items: stretch;
  background: var(--card);
  border-radius: var(--radius);
  padding: 28rpx 24rpx;
  margin-bottom: 18rpx;
  box-shadow: var(--shadow);
  border-left: 8rpx solid var(--ink-soft);
}

.memo-item.is-due {
  border-left-color: var(--accent);
}

.memo-item.is-done {
  opacity: 0.62;
  border-left-color: var(--line);
}

.memo-main {
  flex: 1;
  min-width: 0;
}

.memo-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 10rpx;
}

.memo-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.time {
  font-size: 22rpx;
  color: var(--muted);
}

.memo-preview {
  font-size: 24rpx;
  color: var(--muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.memo-actions {
  display: flex;
  align-items: center;
  padding-left: 16rpx;
}

.check {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 3rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #fff;
}

.check.on {
  background: var(--ok);
  border-color: var(--ok);
}

.fab-wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 48rpx;
  display: flex;
  justify-content: center;
  pointer-events: none;
}

.fab {
  pointer-events: auto;
  min-width: 280rpx;
  box-shadow: 0 12rpx 32rpx rgba(196, 92, 38, 0.35);
}
